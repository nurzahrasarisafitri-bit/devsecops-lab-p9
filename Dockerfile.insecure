# BAD: base image besar dengan banyak package tidak diperlukan
FROM ubuntu:18.04
# BAD: apt-get tanpa membersihkan cache
RUN apt-get update
RUN apt-get install -y python3 python3-pip curl wget
# BAD: copy seluruh direktori (termasuk file sensitif)
COPY . /app
# BAD: tidak set WORKDIR
RUN cd /app && pip3 install flask==2.0.3
# BAD: berjalan sebagai root (tidak ada USER)
# BAD: menyimpan credential di ENV
ENV DB_PASSWORD=supersecret123
ENV API_KEY=abc123xyz
EXPOSE 8080
CMD ["python3", "/app/app.py"]
